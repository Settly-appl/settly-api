{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 5MB
	}

	handle /api/* {
		reverse_proxy settly-api:8080
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Everything else: the Flutter web app (nginx static server).
	handle {
		reverse_proxy settly-web:80
	}
}
